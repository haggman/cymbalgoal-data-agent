# Copy this to `.env` in the directory you point `adk web` at — NOT inside the
# agent package. ADK loads it from beside the package, not from within it.
#
#   cd ~/cymbalgoal-data-agent/agents
#   sed "s|YOUR_PROJECT_ID|$(gcloud config get-value project)|" \
#       ../agents-solution/.env.example > .env

# Reach Gemini through Vertex AI in your own project. Without this, ADK's
# default is Google AI Studio, which wants a GOOGLE_API_KEY — and the failure
# lands on the *model* call, so it reads like broken MCP wiring.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID

# Must be your AlloyDB cluster's region. gemini-2.5-flash is served from
# regional endpoints; Gemini 3.x is served only from `global`. Mixing the two
# produces a 404 that reads like a permissions problem.
GOOGLE_CLOUD_LOCATION=us-central1
