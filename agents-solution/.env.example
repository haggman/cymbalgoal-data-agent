# `adk create` generates this file for you inside the agent package. This copy
# exists only for rebuilding by hand outside the lab:
#
#   sed "s|YOUR_PROJECT_ID|$(gcloud config get-value project)|" \
#       ../agents-solution/.env.example > cymbalgoal_agent/.env

# Reach Gemini through Vertex AI in your own project. Without this, ADK's
# default is Google AI Studio, which wants a GOOGLE_API_KEY — and the failure
# lands on the *model* call, so it reads like broken MCP wiring.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID

# The MODEL's endpoint -- NOT your database's region. gemini-3.7-flash is
# served only from `global`. The AlloyDB cluster lives in us-central1, and
# agent.py names that region itself rather than reading this variable.
GOOGLE_CLOUD_LOCATION=global
